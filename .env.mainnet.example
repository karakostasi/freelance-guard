# Settings for REAL MONEY (Base mainnet). Copy to .env.mainnet, fill it in, and use it only for this:
#   ENV_FILE=.env.mainnet npm run deploy:mainnet
# Never put these values in .env (the test network's file), and never commit .env.mainnet.
# The full procedure, with what each step checks, is in docs/mainnet.md.

# ---------------------------------------------------------------- deploying the escrow (scripts/deploy-mainnet.cjs)
# Your own Base mainnet RPC (Alchemy, Infura, QuickNode...). There is no default.
BASE_RPC_URL=
# A key made for this deploy and nothing else, from a fresh wallet, with a little ETH on Base. It holds no role: the owner is a
# multisig that goes into the constructor. Drop this key after the deploy.
MAINNET_DEPLOYER_PRIVATE_KEY=
# Safes (multisigs) on Base. Different from each other and from the deploying key. 3 signers or more, a threshold below the
# number of signers (2 of 3 is the least), hardware wallets, and no signer who is on both. The arbiter can never be changed.
OWNER_ADDRESS=
ARBITER_ADDRESS=
# Where the fees go. A Safe too, if you can.
TREASURY_ADDRESS=
# Days the payer has to review delivered work. It can never be changed.
REVIEW_PERIOD_DAYS=3
# The smallest fee and the smallest job, in whole tokens (the launch values in docs/business-model.md are 40 and 2000 euros).
# The fee can be at most 5% of the job. USDC is not euros: work out the dollar amounts from the rate on the day.
USDC_MIN_FEE=
USDC_MIN_JOB=
EURC_MIN_FEE=40
EURC_MIN_JOB=2000
# Not asked: the tokens are Circle's (USDC_ADDRESS and EURC_ADDRESS are refused if they are anything else), and there are no
# mocks and no yield vault.
# To publish the source on Basescan (npx hardhat verify). One Etherscan key works for Base too.
ETHERSCAN_API_KEY=
# Nothing is sent until both are set. CONFIRM_CHAIN_ID is typed in on purpose: 8453.
# EXECUTE=1
# CONFIRM_CHAIN_ID=8453

# ---------------------------------------------------------------- the backend
# With a chain id of a real network, the backend refuses to start unless every line below is in order.
EXPECTED_CHAIN_ID=8453
RPC_URL=
ESCROW_ADDRESS=
# Random values of at least 32 characters, different from each other: openssl rand -hex 32
WEBHOOK_SECRET=
SESSION_SECRET=
# https addresses only.
CORS_ORIGIN=
APP_URL=
PUBLIC_API_URL=
# Postgres (Supabase: the Session pooler URI).
DATABASE_URL=
# Must stay empty on a real network: it is the key that creates play money.
# MINT_PRIVATE_KEY=

# ---------------------------------------------------------------- the website (what Vercel is given)
VITE_CHAIN=base
VITE_ESCROW_ADDRESS=
VITE_ESCROW_DEPLOY_BLOCK=
VITE_API_URL=
# Your own RPC for reading the chain. The public one is shared and limits what can be read.
VITE_RPC_URL=
# The CDP project for real money, with its allowed origins and the paymaster set up in the CDP Portal.
VITE_CDP_PROJECT_ID=
