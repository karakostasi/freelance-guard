{
  "name": "freelance-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.cjs",
    "test": "hardhat test",
    "test:unit": "node --experimental-strip-types --no-warnings scripts/test-unit.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "node": "hardhat node",
    "server": "node server/index.mjs",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:base-sepolia": "hardhat run scripts/deploy.cjs --network baseSepolia",
    "predev": "npm run compile",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-org/account": "^2.5.13",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.57.5",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "hardhat": "^2.29.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
