VITE_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Optional: block the contract was deployed in (printed by the deploy script). Speeds up event lookups.
VITE_ESCROW_DEPLOY_BLOCK=

# Frontend: backend URL (default http://localhost:8787). The app falls back to a local demo if it is down.
VITE_API_URL=
# Frontend, optional: the Coinbase Developer Platform project id (CDP Portal > project settings). It turns on the email
# login, which makes a wallet for people who have none. Add the app's address (http://localhost:5173 and your Vercel URL)
# to the allowed origins in the portal's Embedded Wallets settings. Without it only MetaMask can sign in.
VITE_CDP_PROJECT_ID=
# Frontend, only for a local Hardhat chain (npm run node): 1 offers that chain in the wallet. Leave it empty otherwise.
VITE_LOCAL_CHAIN=
# Frontend: the network this build is for. "base-sepolia" (the default) is play money. "base" is REAL money: read docs/mainnet.md
# and use .env.mainnet.example, not this file.
VITE_CHAIN=

# Backend (pnpm server). ESCROW_ADDRESS defaults to VITE_ESCROW_ADDRESS.
RPC_URL=https://sepolia.base.org
WEBHOOK_SECRET=change-me
# Signs the sessions people get after signing in. Falls back to WEBHOOK_SECRET. Both are required, and different, on a real network.
SESSION_SECRET=
# The network the backend is meant for. For a real one it refuses to start if its RPC says otherwise, and holds itself to the
# rules of real money (see docs/mainnet.md). STRICT=1 does the same on a test network, to rehearse.
EXPECTED_CHAIN_ID=
STRICT=
# Postgres connection string (Supabase: use the "Session pooler" URI). Without it the backend keeps state in server/data/db.json.
DATABASE_URL=
# Frontend origin allowed to call the backend (default: any)
CORS_ORIGIN=
# Optional: URL that receives job.funded / work.submitted / payout.settled notifications
NOTIFY_WEBHOOK_URL=
# Backend, optional: email notifications through Resend (resend.com). Without a key, emails are only logged.
# MAIL_FROM needs a verified domain at Resend, otherwise it can only deliver to your own account's address.
RESEND_API_KEY=
MAIL_FROM=
# Where the frontend and the backend live, used for the links inside emails (defaults shown)
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787

# Token addresses (default: Circle's Base Sepolia test tokens). Override for a local mock token.
VITE_EURC_ADDRESS=
VITE_USDC_ADDRESS=
# Backend: the EURC and USDC the payment flow uses (the mock ones, if it should create them for the payer)
EURC_ADDRESS=
USDC_ADDRESS=
# Backend, test networks only: a key that may mint the mock tokens, standing in for an on-ramp that delivers them. Never on a real network.
MINT_PRIVATE_KEY=

# Deploy script (hardhat run scripts/deploy.cjs): who runs the escrow. They default to the deployer.
ARBITER_ADDRESS=
TREASURY_ADDRESS=
# Offered ownership at the end of the deploy, and must call acceptOwnership()
OWNER_ADDRESS=
# Smallest fee and smallest job, in euros (launch values: 40 and 2000)
MIN_FEE_EUR=
MIN_JOB_EUR=
# 1 deploys a mock USDC (and a mock vault for it) or a mock EURC on a test network. Circle's test tokens can't be minted.
# Or point at a vault you have.
MOCK_USDC=
MOCK_EURC=
USDC_VAULT_ADDRESS=

# Your own Base Sepolia RPC URL (Alchemy, Infura, QuickNode...). The default public one is shared and rate-limited.
VITE_BASE_SEPOLIA_RPC_URL=
# Frontend: the RPC to read the chain with, on either network (this one wins over the line above).
VITE_RPC_URL=

# Backend, optional: file upload limits (defaults shown)
MAX_FILE_MB=10
UPLOADS_PER_DAY=50
UPLOAD_MB_PER_DAY=200
FILES_MAX_TOTAL_MB=300
